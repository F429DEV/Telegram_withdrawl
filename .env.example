# 从 @BotFather 拿到的 token
BOT_TOKEN=123456:ABC-DEF...

# SQLite 数据库文件路径（相对或绝对都行）
DB_PATH=data/lottery.db

# 机器人主人的 Telegram 用户 ID，多个用逗号分隔。
# 主人可以在任何群里使用管理命令，留空则只认群管理员。
OWNER_IDS=

# 日志级别 DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# 单个群同时进行的抽奖上限
MAX_ACTIVE_PER_CHAT=5

# 消息里显示时间用的时区
DISPLAY_TZ=Asia/Shanghai
