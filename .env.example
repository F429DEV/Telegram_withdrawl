# 从 @BotFather 拿到的 token
BOT_TOKEN=123456:ABC-DEF...

# SQLite 数据库文件路径（相对或绝对都行）
DB_PATH=data/lottery.db

# 机器人主人的 Telegram 用户 ID，多个用逗号分隔。
# 主人可以在任何群里使用管理命令，留空则只认群管理员。
OWNER_IDS=

# 日志级别 DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# 单个群同时进行的抽奖上限
MAX_ACTIVE_PER_CHAT=5

# 消息里显示时间用的时区
DISPLAY_TZ=Asia/Shanghai

# 日志文件路径（相对项目目录）。留空 = 只往控制台打，不写文件
LOG_FILE=logs/bot.log
# 单个日志文件多大就滚动一次（MB），以及保留几份历史
LOG_MAX_MB=10
LOG_BACKUPS=5

# 机器人在群里发的消息，多少秒后自动删掉（防刷屏）。0 = 不删。
# 抽奖卡片、开奖结果、创建面板永远保留；私聊消息永远不删。
EPHEMERAL_SECONDS=30
